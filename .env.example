# Copy to .env (never commit .env). Every value is optional.
# Leave a value empty to disable that integration.

# Cloud AI (Anthropic Claude). Without it JARVIS uses Ollama or the dev fallback.
ANTHROPIC_API_KEY=

# Home Assistant long-lived access token (Profile -> Security -> Long-lived tokens).
HA_TOKEN=

# Discord webhook for phone notifications (Server settings -> Integrations -> Webhooks -> Copy Webhook URL).
# Must be https://discord.com/api/webhooks/... Treat it like a password.
# DISCORD_WEBHOOK_URL=
